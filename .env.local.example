# Neon Postgres (provisionado via Vercel Marketplace)
DATABASE_URL=

# Vercel Blob (provisionado via Vercel, vercel env pull)
BLOB_READ_WRITE_TOKEN=

# Clerk (provisionado via Vercel Marketplace)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Segredo próprio para assinar o cookie de sessão do colaborador (gerar uma string aleatória longa)
PARTICIPANT_SESSION_SECRET=

# URL pública de produção, usada para montar o link de validação embutido no certificado
# (ex: https://certificados.lidersaude.com.br). Sem isso, cai no domínio Vercel automático.
NEXT_PUBLIC_APP_URL=
