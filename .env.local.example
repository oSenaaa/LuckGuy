# Neon Postgres (provisionado via Vercel Marketplace)
DATABASE_URL=

# Vercel Blob (provisionado via Vercel, vercel env pull)
BLOB_READ_WRITE_TOKEN=

# Clerk (provisionado via Vercel Marketplace)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ID da organização Clerk autorizada a acessar o /admin (org_...).
# Sem esta variável, NINGUÉM é admin (fail-closed). Habilite Organizations no
# Clerk, crie a org da LÍDER, convide a equipe com o papel org:admin e cole o ID aqui.
ADMIN_ORG_ID=

# Segredo próprio para assinar o cookie de sessão do colaborador (gerar uma string aleatória longa)
PARTICIPANT_SESSION_SECRET=

# URL pública de produção, usada para montar o link de validação embutido no certificado
# (ex: https://certificados.lidersaude.com.br). Sem isso, cai no domínio Vercel automático.
NEXT_PUBLIC_APP_URL=

# Segredo para o HMAC de integridade impresso/gravado no certificado
# (openssl rand -hex 32). Trocar invalida a verificação de integridade dos certificados já emitidos.
CERTIFICATE_SIGNING_SECRET=

# Upstash Redis para rate limiting (Vercel Marketplace:
# `vercel integration add upstash/upstash-kv` e depois `vercel env pull`).
# Ausentes em dev -> rate limiting desativado (no-op).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
